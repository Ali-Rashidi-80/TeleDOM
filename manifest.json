{
  "manifest_version": 3,
  "name": "TeleDOM — AI Agent Browser & DOM Forensic Platform (121 Tools)",
  "version": "3.0.0",
  "description": "Autonomous AI Agent Browser Interface, DOM Time-Travel Debugger, Lifecycle Tracer, Mutation Engine & 121-Tool MCP Suite.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs",
    "webNavigation",
    "management"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "dist/extension/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/extension/content-script.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "dist/src/extension/popup/popup.html",
    "default_title": "TeleDOM Agent & Forensic Controls",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "devtools_page": "dist/src/extension/devtools/devtools.html",
  "web_accessible_resources": [
    {
      "resources": [
        "dist/extension/page-script.js",
        "dist/src/ui/*",
        "dist/assets/*",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}